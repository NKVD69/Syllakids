{
  "name": "syllakids",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Syllakids — apprendre à lire avec la méthode syllabique (5-6 ans)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @syllakids/app",
    "build": "npm run build -w @syllakids/app",
    "test": "vitest run",
    "typecheck": "tsc -p packages/decodabilite && tsc -p apps/app --noEmit",
    "contenu:verifier": "vitest run content",
    "contenu:generer": "tsx scripts/generer-contenu.ts"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
