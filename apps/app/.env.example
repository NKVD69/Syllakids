# Copier ce fichier en .env.local (jamais versionné) et remplir l'une des deux options.

# Production : projet Supabase hébergé dans l'Union européenne (voir docs/supabase.md).
# La clé « anon » est publique par conception : la sécurité repose sur les règles de la base.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Développement : serveur local (npm run serveur:local), sans compte Supabase.
# VITE_SERVEUR_LOCAL=http://localhost:54330

# Adresse de contact de l'éditeur, affichée aux enseignants dont le compte attend la vérification.
VITE_CONTACT=
